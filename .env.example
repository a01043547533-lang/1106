# server/.env 에 아래 항목을 추가하세요 (API 키·요청주소는 기존 그대로)

# 검색 최적화 — 도메인을 연결하면 실제 주소로 바꿔요 (canonical·sitemap·RSS에 쓰임)
SITE_URL=http://localhost:3000

# 네이버 서치어드바이저 → 사이트 등록 → "HTML 태그" 방식의 content 값
NAVER_SITE_VERIFICATION=

# 구글 서치 콘솔 → URL 접두어 → "HTML 태그" 방식의 content 값
GOOGLE_SITE_VERIFICATION=

# 문의처 이메일 (개인정보처리방침·광고 안내에 표시)
CONTACT_EMAIL=

# Resend HTTP API. 키가 비어 있으면 보낼 내용을 콘솔에만 출력합니다.
MAIL_PROVIDER=Resend
MAIL_KEY=
MAIL_FROM=

# 직접 접속은 비워 둡니다. 같은 서버의 Nginx는 loopback으로 설정합니다.
TRUST_PROXY=

# 웹 서버/수집기/알림기가 공유할 영속 경로. 기본 server/data
DATA_DIR=

# 일반 선발배점 API는 공식 주소의 이중 슬래시를 유지해야 합니다.
MMA_URL_SCORE=https://apis.data.go.kr/1300000//bjGiJun/list/bjGiJun/list
