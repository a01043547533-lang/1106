# 실제 값은 server/.env 또는 Vercel 서버 환경변수에만 설정합니다.
# VITE_ 접두사를 쓰지 마세요. 키는 브라우저와 GitHub에 전달하지 않습니다.
MMA_API_KEY=
CONTACT_EMAIL=
# 아래는 선택 설정입니다. 비워 두면 코드의 공식 주소를 사용합니다.
# 일반 선발배점은 이중 슬래시를 유지합니다.
MMA_URL_SCORE=https://apis.data.go.kr/1300000//bjGiJun/list/bjGiJun/list
# ── 검색·광고 (도메인 연결 후 설정) ─────────────────────────────
# canonical·sitemap·robots에 쓰는 사이트 주소. 끝에 / 없이. Vercel에는 빌드 환경변수로도 넣는다.
# SITE_URL=https://example.com
# VITE_SITE_URL=https://example.com
# 문의 페이지에 표시할 이메일 (서버 환경변수)
# CONTACT_EMAIL=you@example.com
# Google AdSense 게시자 ID. 심사 신청 시 발급받은 ca-pub-… 값을 넣고 다시 빌드하면 head에 AdSense 스크립트가 들어간다(심사 코드·자동 광고).
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# (선택) IP당 분당 API 요청 한도. 기본 120. Vercel에서는 방문자 IP(x-real-ip)로 셉니다.
# RATE_LIMIT_PER_MIN=120
# 서치콘솔·네이버 서치어드바이저 소유 확인 메타 태그 값
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=
