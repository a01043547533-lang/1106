{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "regions": ["icn1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/data/{prepared/**,calendar.json,final_rates.json,links.json,lottery.json,rules.json,service_terms.json,snapshots.jsonl,forecast.json,exam_schedule.json,eligible_items.json}",
      "excludeFiles": "{server/.env,server/env,server/data/_raw/**,server/data/_backup/**,.checks/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
